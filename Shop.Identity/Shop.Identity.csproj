<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13"> <!-- بتستخدم لتوليد ملفات المايجريشن -->
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.13" /> <!-- بتستخدم لقراءة ملفات الإعدادات بصيغة JSON -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" /> <!-- بتستخدم للتعامل مع قاعدة بيانات PostgreSQL -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" /> <!-- بتستخدم للتعامل مع JSON Web Tokens (JWT) -->
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><!-- بينسخ الملف appsettings.json في مجلد bin\Debug\net10.0\appsettings.json -->
    </None>
  </ItemGroup>

</Project>
